# ---------------------------------------------------------------------------
# AI Talking Girl — local environment variables
# NEVER prefix these with NEXT_PUBLIC_ or they will be shipped to the browser.
# The Gemini call happens exclusively in the server route handler /api/chat.
# ---------------------------------------------------------------------------

# Get a key at https://aistudio.google.com/apikey
# ⚠️  REPLACE THE VALUE BELOW WITH YOUR REAL KEY.
#     The literal text "your_api_key_here" is detected as unconfigured and the
#     API will refuse to run. Check it any time:
#     curl http://localhost:3000/api/chat/health
GEMINI_API_KEY=your_api_key_here

# Optional overrides.
# NOTE: gemini-2.0-flash has been SHUT DOWN by Google and now returns 404.
# If you override GEMINI_MODEL, use a current model, e.g.:
#   GEMINI_MODEL=gemini-flash-latest
#   GEMINI_MODEL=gemini-3.8-flash
# When unset, the app auto-tries, in order:
#   gemini-flash-latest, gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TEMPERATURE=0.8
# GEMINI_MAX_TOKENS=220
